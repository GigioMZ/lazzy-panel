[Unit]
Description=Lazzy bot de Telegram
After=network-online.target
Wants=network-online.target

[Service]
User=lazzy
WorkingDirectory=/opt/lazzy-panel
Environment=LAZZY_DB=/var/lib/lazzy/lazzy.db
Environment=LAZZY_ARCHIVOS=/var/lib/lazzy/archivos
ExecStart=/opt/lazzy-panel/.venv/bin/python -m lazzy.bot
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
